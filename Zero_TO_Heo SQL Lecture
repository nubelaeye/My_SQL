-- Keys..
-- 1. Primary key -> It is a column(or set of columns) in a table that uniquely identifies each row.
-- there can be only one primary key in a given table.. neither should be not null..

-- 2. Foriegn Key -> A foreign key is a column(or set of columns) in a table that refers to the primary key 
-- of another table..
-- There can be multiple Foreign keys..
-- Foreign key have duplicate & null values..
-- A primary key of any table may act as a foreign key for any other table..


-- Constraints..
-- SQL contraints are used to specify rules for data in a table.. Some of the following constraints are given below..
-- 1. Not null -> columns cannot have null; example- col1 int not null
-- 2. Unique -> all values in column are different; example- col2 int unique
-- 3. Primary key -> makes a column unique and not null but only for one... we can provide two arguments together
-- and define the primary key constraints as.. 
create table tab2(
	id int,
    name varchar(50),
    age int,
    city varchar(90),
    primary key(id,name) -- Now at this place id and name can be same but one of them will vary from other.
    
);

-- 4. Foreign Key -> prevents actions that would destroy linkes between tables..
create table temp(
	creat_id int,
    foreign key (creat_id) references tab2(id) 
    -- basic syntax: 
    -- 1. create a variable..
    -- 2. syntax : foreign key (created_variable_name) references another_table_name(column_name);
    
); 

-- 5. Default -> sets the default value for a column..
create table for_defaut(
	salary int default 2000,
    name varchar(50) default "Hiroshi Nohara.."
);


-- 6. Check Constraint ->  it can limit the values allowed in a column..(Kind of if statement)
create table city(
	id int primary key,
    city varchar(50),
    age int,
    constraint age check (age>=18 And city = "Delhi") -- here constraint word is also important 
     
);

-- Basic syntax: constraint variable_name check (var_name>=18 and city = "Delhi");

